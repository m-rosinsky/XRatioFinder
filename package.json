{
  "name": "x-ratio-finder",
  "version": "0.1.0",
  "description": "X Ratio Finder - A tool for finding optimal ratios",
  "private": true,
  "type": "module",
  "main": "src/index.tsx",
  "module": "src/index.tsx",
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "dev:mock": "bun --hot src/index.tsx --mock",
    "start": "NODE_ENV=production bun src/index.tsx",
    "start:mock": "NODE_ENV=production bun src/index.tsx --mock",
    "build": "bun run build.ts"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.0.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/bun": "latest"
  }
}
